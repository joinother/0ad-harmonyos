+// Pick the UI language from the OS unless the user set one explicitly.
+static void AutoDetectLocale()
+{
+	int numLocales = 0;
+	SDL_Locale** preferred = SDL_GetPreferredLocales(&numLocales);
+	if (preferred && numLocales > 0 && preferred[0]->language)
+	{
+		const std::string configuredLocale = g_ConfigDB.Get("locale", std::string{});
+		if (configuredLocale.empty())
+		{
+			std::string lang = preferred[0]->language;
+			const std::string country = preferred[0]->country ? preferred[0]->country : "";
+			std::string script;
+			const size_t dash = lang.find('-');
+			if (dash != std::string::npos)
+			{
+				script = lang.substr(dash + 1);
+				lang = lang.substr(0, dash);
+			}
+			std::string code;
+			if (lang == "zh")
+			{
+				const bool traditional = (script == "Hant") ||
+					country == "TW" || country == "HK" || country == "MO";
+				code = traditional ? "zh_TW" : "zh";
+			}
+			else if (lang == "pt")
+				code = (country == "BR") ? "pt_BR" : "pt_PT";
+			else if (lang == "en")
+				code = (country == "GB") ? "en_GB" : "en";
+			else
+				code = lang;
+			if (!code.empty() && code != "en")
+			{
+				g_ConfigDB.SetValueString(CFG_USER, "locale", code);
+				LOGMESSAGE("Auto-selected UI locale '%s' from system language", code.c_str());
+			}
+		}
+	}
+	SDL_free(preferred);
+}
