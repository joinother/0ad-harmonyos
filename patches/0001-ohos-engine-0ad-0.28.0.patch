+// glMapBufferRange (GL_ARB_map_buffer_range loader resolves it on GLES3).
+static inline void* OH_MapBufferForWrite(GLenum target, GLenum access)
+{
+	GLint bufSize = 0;
+	glGetBufferParameteriv(target, GL_BUFFER_SIZE, &bufSize);
+	if (bufSize <= 0) return NULL;
+	GLbitfield bits;
