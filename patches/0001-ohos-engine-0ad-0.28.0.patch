+void CCameraController::TouchpadPan(float dxPx, float dyPx)
+{
+	// Natural "grab the map" mapping (matches touch screens and natural-scrolling
+	// trackpads): pull the map right (dx>0) to reveal the left side (camera moves
+	// left); pull the map down (dy>0) to reveal what is above (camera moves forward).
+	// m_ViewDragSpeed is world-distance per pixel.
+	const float moveRightward = -dxPx * m_ViewDragSpeed;
+	const float moveForward = dyPx * m_ViewDragSpeed;
+
+	m_FollowEntity = INVALID_ENTITY;
+
+	const float s = sin(m_RotateY.GetSmoothedValue());
+	const float c = cos(m_RotateY.GetSmoothedValue());
+	m_PosX.AddSmoothly(c * moveRightward + s * moveForward);
+	m_PosZ.AddSmoothly(-s * moveRightward + c * moveForward);
+}
+
 InReaction CCameraController::HandleEvent(const SDL_Event_* ev)
 {
+	if (m_TouchpadGestureEventType != 0 && ev->ev.type == m_TouchpadGestureEventType)
+	{
+		auto ptrAsFloat = [](void* p) -> float {
+			union { intptr_t u; int32_t i; } a;
+			a.u = (intptr_t) p;
+			union { int32_t i; float f; } b;
+			b.i = a.i;
+			return b.f;
+		};
+		const int code = ev->ev.user.code;
+		if (code == SDL_OPENHARMONY_TOUCHPAD_GESTURE_PAN)
+		{
+			TouchpadPan(ptrAsFloat(ev->ev.user.data1), ptrAsFloat(ev->ev.user.data2));
+		}
+		else if (code == SDL_OPENHARMONY_TOUCHPAD_GESTURE_PINCH)
+		{
+			// Outward (delta > 0) zooms in, which decreases m_Zoom.
+			const float d = ptrAsFloat(ev->ev.user.data1);
+			m_Zoom.AddSmoothly(-d * 500.0f);
+		}
+		return IN_HANDLED;
+	}
+
 	switch (ev->ev.type)
 	{
 	case SDL_HOTKEYPRESS:
